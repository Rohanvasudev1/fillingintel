# EDGAR — required by SEC fair-access policy; format: "AppName/version Name contact@email.com"
EDGAR_USER_AGENT=

# Postgres (used by docker-compose and application)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=filingintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/filingintel

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Voyage embeddings (Step 5): python -m ingest.embed
VOYAGE_API_KEY=

# Anthropic answer model (Step 5): python -m eval.run
ANTHROPIC_API_KEY=
