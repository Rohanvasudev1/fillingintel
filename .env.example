# EDGAR — required by SEC fair-access policy; format: "AppName/version Name contact@email.com"
EDGAR_USER_AGENT=

# Postgres (used by docker-compose and application)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=filingintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/filingintel

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Voyage embeddings (Step 5): python -m ingest.embed
VOYAGE_API_KEY=

# Anthropic answer model (Step 5): python -m eval.run
ANTHROPIC_API_KEY=

# OpenAI judge model (Step 5): python -m eval.run. Leave OPENAI_BASE_URL unset.
OPENAI_API_KEY=

# Phoenix tracing (Step 6). Tracing is off unless PHOENIX_COLLECTOR_ENDPOINT is set.
# Phoenix runs with `docker compose up -d`; its UI is at http://localhost:6006.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Prompt and answer text go on spans only when this is true.
# FILINGINTEL_TRACE_TEXT=false
